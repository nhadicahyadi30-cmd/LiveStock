{
  "name": "@sl/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "node scripts/with-env.mjs prisma generate",
    "validate": "node scripts/with-env.mjs prisma validate",
    "push": "node scripts/with-env.mjs prisma db push",
    "migrate": "node scripts/with-env.mjs prisma migrate dev",
    "rls": "node scripts/with-env.mjs tsx scripts/apply-sql.ts",
    "seed": "node scripts/with-env.mjs tsx prisma/seed.ts",
    "seed:demo": "node scripts/with-env.mjs tsx prisma/seed-demo.ts",
    "seed:photos": "node scripts/with-env.mjs tsx prisma/seed-photos.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/with-env.mjs vitest run"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
