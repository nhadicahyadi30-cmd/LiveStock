// Skema inti MVP Nusa Ternak.
// Mengikuti dokumen "Desain Database MVP": UUID, timestamptz UTC, organization_id pada tabel bertenant.
// Yang TIDAK bisa dinyatakan di Prisma (RLS, CHECK, view, trigger, grant) ada di prisma/sql/*.sql.
//
// Belum ada di skema ini (menyusul sesuai dokumen): breeds, farm_sites, animal_identifiers, movements,
// feed_types, feed_records, production_records, health_records, tasks, attachments, report_jobs,
// notifications, invitations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("MIGRATION_DATABASE_URL")
}

// ---------------------------------------------------------------- Enum

enum Role {
  OWNER
  MANAGER
  WORKER
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum Plan {
  FREE
  STARTER
  PRO
  BUSINESS
  ENTERPRISE
}

enum FarmStatus {
  ACTIVE
  ARCHIVED
}

enum FacilityType {
  BARN
  HOUSE
  POND
  PEN
}

enum TrackingMode {
  INDIVIDUAL
  GROUP
  BOTH
}

enum Sex {
  MALE
  FEMALE
  UNKNOWN
}

enum AnimalStatus {
  ACTIVE
  SOLD
  DEAD
  CULLED
  TRANSFERRED
}

enum BatchStatus {
  ACTIVE
  CLOSED
}

enum BatchEventType {
  ADDED
  CULLED
  SOLD
  ADJUSTMENT
}

// Contoh awal; daftar final perlu disetujui bersama peternak pilot.
enum MortalityCause {
  DISEASE
  INJURY
  PREDATION
  ENVIRONMENT
  UNKNOWN
  OTHER
}

// ---------------------------------------------------------------- Identity dan tenant

model User {
  id              String       @id @default(uuid(7)) @db.Uuid
  email           String       @unique
  name            String?
  passwordHash    String?      @map("password_hash")
  emailVerifiedAt DateTime?    @map("email_verified_at") @db.Timestamptz(6)
  locale          String       @default("id")
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships     Membership[]

  @@map("users")
}

model Organization {
  id           String       @id @default(uuid(7)) @db.Uuid
  name         String
  slug         String       @unique
  countryCode  String       @default("ID") @map("country_code")
  language     String       @default("id")
  currencyCode String       @default("IDR") @map("currency_code")
  timezone     String       @default("Asia/Jakarta")
  plan         Plan         @default(FREE)
  planExpiresAt DateTime?   @map("plan_expires_at") @db.Timestamptz(6)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships  Membership[]
  farms        Farm[]

  @@map("organizations")
}

model Membership {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           Role
  status         MembershipStatus @default(ACTIVE)
  allFarms       Boolean          @default(true) @map("all_farms")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  farms          MembershipFarm[]

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([userId])
  @@map("memberships")
}

// Daftar farm yang boleh diakses bila memberships.all_farms = false.
model MembershipFarm {
  organizationId String     @map("organization_id") @db.Uuid
  membershipId   String     @map("membership_id") @db.Uuid
  farmId         String     @map("farm_id") @db.Uuid
  membership     Membership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)
  farm           Farm       @relation(fields: [organizationId, farmId], references: [organizationId, id], onDelete: Cascade)

  @@id([membershipId, farmId])
  @@index([organizationId, farmId])
  @@map("membership_farms")
}

model AuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id") @db.Uuid
  before         Json?
  after          Json?
  ipAddress      String?  @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, entityType, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------- Spesies, farm, fasilitas

// Referensi global: tidak punya organization_id; tenant hanya boleh membaca.
model Species {
  id            String           @id @default(uuid(7)) @db.Uuid
  code          String           @unique
  name          String
  trackingMode  TrackingMode     @map("tracking_mode")
  metricsConfig Json?            @map("metrics_config")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  animals       Animal[]
  batches       LivestockBatch[]

  @@map("species")
}

model Farm {
  id              String           @id @default(uuid(7)) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  name            String
  code            String
  address         String?
  timezone        String?
  status          FarmStatus       @default(ACTIVE)
  createdBy       String?          @map("created_by") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  facilities      Facility[]
  animals         Animal[]
  batches         LivestockBatch[]
  membershipFarms MembershipFarm[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@map("farms")
}

model Facility {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  farmId         String       @map("farm_id") @db.Uuid
  type           FacilityType
  name           String
  capacity       Int?
  status         String       @default("ACTIVE")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  farm           Farm         @relation(fields: [organizationId, farmId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, farmId])
  @@map("facilities")
}

// ---------------------------------------------------------------- Ternak dan batch

model Animal {
  id              String       @id @default(uuid(7)) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  farmId          String       @map("farm_id") @db.Uuid
  facilityId      String?      @map("facility_id") @db.Uuid
  speciesId       String       @map("species_id") @db.Uuid
  code            String
  name            String?
  sex             Sex?
  birthDate       DateTime?    @map("birth_date") @db.Date
  acquisitionDate DateTime?    @map("acquisition_date") @db.Date
  status          AnimalStatus @default(ACTIVE)
  attributes      Json?
  clientId        String?      @map("client_id") @db.Uuid
  createdBy       String?      @map("created_by") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  farm            Farm         @relation(fields: [organizationId, farmId], references: [organizationId, id], onDelete: Restrict)
  species         Species      @relation(fields: [speciesId], references: [id], onDelete: Restrict)

  @@unique([organizationId, code])
  @@unique([organizationId, clientId])
  @@unique([organizationId, id])
  @@index([organizationId, farmId, status])
  @@index([organizationId, speciesId])
  @@map("animals")
}

model LivestockBatch {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  farmId         String       @map("farm_id") @db.Uuid
  facilityId     String?      @map("facility_id") @db.Uuid
  speciesId      String       @map("species_id") @db.Uuid
  code           String
  startDate      DateTime     @map("start_date") @db.Date
  initialCount   Int          @map("initial_count")
  status         BatchStatus  @default(ACTIVE)
  closedAt       DateTime?    @map("closed_at") @db.Timestamptz(6)
  attributes     Json?
  clientId       String?      @map("client_id") @db.Uuid
  createdBy      String?      @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  farm           Farm         @relation(fields: [organizationId, farmId], references: [organizationId, id], onDelete: Restrict)
  species        Species      @relation(fields: [speciesId], references: [id], onDelete: Restrict)
  events         BatchEvent[]

  @@unique([organizationId, code])
  @@unique([organizationId, clientId])
  @@unique([organizationId, id])
  @@index([organizationId, farmId, status])
  @@map("livestock_batches")
}

// delta bertanda: positif menambah populasi, negatif mengurangi.
model BatchEvent {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  batchId        String         @map("batch_id") @db.Uuid
  eventType      BatchEventType @map("event_type")
  delta          Int
  occurredOn     DateTime       @map("occurred_on") @db.Date
  note           String?
  recordedBy     String         @map("recorded_by") @db.Uuid
  clientId       String?        @map("client_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  batch          LivestockBatch @relation(fields: [organizationId, batchId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, clientId])
  @@index([organizationId, batchId, occurredOn])
  @@map("batch_events")
}

// ---------------------------------------------------------------- Catatan operasional
// animal_id dan batch_id: tepat satu terisi (CHECK di prisma/sql/003_constraints.sql).

model WeightRecord {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  animalId       String?   @map("animal_id") @db.Uuid
  batchId        String?   @map("batch_id") @db.Uuid
  measuredOn     DateTime  @map("measured_on") @db.Date
  weightKg       Decimal   @map("weight_kg") @db.Decimal(12, 3)
  sampleSize     Int?      @map("sample_size")
  recordedBy     String    @map("recorded_by") @db.Uuid
  clientId       String?   @map("client_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  voidedAt       DateTime? @map("voided_at") @db.Timestamptz(6)
  voidedBy       String?   @map("voided_by") @db.Uuid
  voidReason     String?   @map("void_reason")

  @@unique([organizationId, clientId])
  @@index([organizationId, animalId, measuredOn(sort: Desc)])
  @@index([organizationId, batchId, measuredOn(sort: Desc)])
  @@map("weight_records")
}

model MortalityRecord {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  animalId       String?        @map("animal_id") @db.Uuid
  batchId        String?        @map("batch_id") @db.Uuid
  occurredOn     DateTime       @map("occurred_on") @db.Date
  count          Int            @default(1)
  cause          MortalityCause @default(UNKNOWN)
  note           String?
  recordedBy     String         @map("recorded_by") @db.Uuid
  clientId       String?        @map("client_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  voidedAt       DateTime?      @map("voided_at") @db.Timestamptz(6)
  voidedBy       String?        @map("voided_by") @db.Uuid
  voidReason     String?        @map("void_reason")

  @@unique([organizationId, clientId])
  @@index([organizationId, batchId, occurredOn])
  @@index([organizationId, animalId])
  @@map("mortality_records")
}

// ---------------------------------------------------------------- Tahap 1: pakan, produksi, tugas, notifikasi
// Perpindahan dan penjualan ternak memakai BatchEvent (SOLD, CULLED, ADDED, ADJUSTMENT), bukan tabel baru.
// Foreign key komposit untuk tabel ini dibuat di prisma/sql/004_phase1.sql (urutan: db push lalu db rls).

enum ProductionKind {
  EGG
  MILK
  HARVEST
}

enum TaskStatus {
  OPEN
  DONE
}

model FeedType {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  unit           String   @default("kg")
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([organizationId, name])
  @@unique([organizationId, id])
  @@map("feed_types")
}

model FeedRecord {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  batchId        String    @map("batch_id") @db.Uuid
  feedTypeId     String    @map("feed_type_id") @db.Uuid
  givenOn        DateTime  @map("given_on") @db.Date
  quantityKg     Decimal   @map("quantity_kg") @db.Decimal(12, 3)
  costTotal      Decimal?  @map("cost_total") @db.Decimal(14, 2)
  note           String?
  recordedBy     String    @map("recorded_by") @db.Uuid
  clientId       String?   @map("client_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  voidedAt       DateTime? @map("voided_at") @db.Timestamptz(6)
  voidedBy       String?   @map("voided_by") @db.Uuid
  voidReason     String?   @map("void_reason")

  @@unique([organizationId, clientId])
  @@index([organizationId, batchId, givenOn(sort: Desc)])
  @@map("feed_records")
}

model ProductionRecord {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  batchId        String         @map("batch_id") @db.Uuid
  kind           ProductionKind
  quantity       Decimal        @db.Decimal(14, 3)
  unit           String
  producedOn     DateTime       @map("produced_on") @db.Date
  note           String?
  recordedBy     String         @map("recorded_by") @db.Uuid
  clientId       String?        @map("client_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  voidedAt       DateTime?      @map("voided_at") @db.Timestamptz(6)
  voidedBy       String?        @map("voided_by") @db.Uuid
  voidReason     String?        @map("void_reason")

  @@unique([organizationId, clientId])
  @@index([organizationId, batchId, producedOn(sort: Desc)])
  @@map("production_records")
}

model Task {
  id             String     @id @default(uuid(7)) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  batchId        String?    @map("batch_id") @db.Uuid
  title          String
  description    String?
  dueOn          DateTime   @map("due_on") @db.Date
  status         TaskStatus @default(OPEN)
  assignedTo     String?    @map("assigned_to") @db.Uuid
  completedAt    DateTime?  @map("completed_at") @db.Timestamptz(6)
  completedBy    String?    @map("completed_by") @db.Uuid
  createdBy      String     @map("created_by") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([organizationId, status, dueOn])
  @@index([organizationId, assignedTo, status])
  @@map("tasks")
}

model Notification {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  kind           String
  title          String
  body           String?
  href           String?
  readAt         DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organizationId, userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

enum AuthTokenKind {
  INVITE
  RESET
}

/// Token sekali pakai untuk undangan anggota dan reset kata sandi. Hanya hash-nya yang disimpan.
/// Sengaja tanpa kolom organization_id: diakses server tanpa konteks tenant (belum ada sesi).
model AuthToken {
  id          String        @id @default(uuid(7)) @db.Uuid
  kind        AuthTokenKind
  tokenHash   String        @unique @map("token_hash")
  email       String
  targetOrgId String?       @map("target_org_id") @db.Uuid
  role        Role?
  invitedBy   String?       @map("invited_by") @db.Uuid
  expiresAt   DateTime      @map("expires_at") @db.Timestamptz(6)
  usedAt      DateTime?     @map("used_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email, kind])
  @@index([targetOrgId])
  @@map("auth_tokens")
}

// ---------------------------------------------------------------- Tahap 2: Kesehatan

enum HealthKind {
  VACCINATION
  TREATMENT
  QUARANTINE
}

enum HealthStatus {
  PLANNED
  ACTIVE
  DONE
}

/// Satu tabel untuk vaksinasi (jadwal -> selesai), pengobatan (berjalan -> selesai), dan karantina.
model HealthRecord {
  id              String       @id @default(uuid(7)) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  batchId         String       @map("batch_id") @db.Uuid
  kind            HealthKind
  status          HealthStatus
  title           String
  medicine        String?
  dose            String?
  affectedCount   Int?         @map("affected_count")
  eventOn         DateTime     @map("event_on") @db.Date
  doneOn          DateTime?    @map("done_on") @db.Date
  withdrawalUntil DateTime?    @map("withdrawal_until") @db.Date
  cost            Decimal?     @db.Decimal(14, 2)
  note            String?
  recordedBy      String       @map("recorded_by") @db.Uuid
  clientId        String?      @map("client_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  voidedAt        DateTime?    @map("voided_at") @db.Timestamptz(6)
  voidedBy        String?      @map("voided_by") @db.Uuid
  voidReason      String?      @map("void_reason")

  @@unique([organizationId, clientId])
  @@index([organizationId, batchId, eventOn(sort: Desc)])
  @@index([organizationId, kind, status])
  @@map("health_records")
}

// ---------------------------------------------------------------- Tahap 3: Marketplace
// Tabel marketplace bersifat lintas organisasi, jadi sengaja TIDAK memakai kolom organization_id
// (kebijakan RLS standar tidak berlaku). Kebijakan khusus ada di prisma/sql/006_phase3.sql.

enum ListingCategory {
  LIVESTOCK
  FEED
  MEDICINE
  EQUIPMENT
  PRODUCE
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MarketOrderStatus {
  PENDING
  ACCEPTED
  SHIPPED
  COMPLETED
  REJECTED
  CANCELLED
}

model VendorProfile {
  orgId       String   @id @map("org_id") @db.Uuid
  displayName String   @map("display_name")
  city        String
  phone       String
  about       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("vendor_profiles")
}

model MarketListing {
  id          String          @id @default(uuid(7)) @db.Uuid
  sellerOrgId String          @map("seller_org_id") @db.Uuid
  title       String
  category    ListingCategory
  description String?
  priceIdr    Decimal         @map("price_idr") @db.Decimal(14, 2)
  unit        String
  stock       Decimal         @db.Decimal(14, 3)
  status      ListingStatus   @default(DRAFT)
  createdBy   String          @map("created_by") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, category, createdAt(sort: Desc)])
  @@index([sellerOrgId])
  @@map("market_listings")
}

model MarketOrder {
  id           String            @id @default(uuid(7)) @db.Uuid
  listingId    String            @map("listing_id") @db.Uuid
  buyerOrgId   String            @map("buyer_org_id") @db.Uuid
  sellerOrgId  String            @map("seller_org_id") @db.Uuid
  listingTitle String            @map("listing_title")
  unit         String
  quantity     Decimal           @db.Decimal(14, 3)
  unitPrice    Decimal           @map("unit_price") @db.Decimal(14, 2)
  total        Decimal           @db.Decimal(16, 2)
  status       MarketOrderStatus @default(PENDING)
  buyerNote    String?           @map("buyer_note")
  createdBy    String            @map("created_by") @db.Uuid
  clientId     String?           @map("client_id") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([buyerOrgId, clientId])
  @@index([buyerOrgId, createdAt(sort: Desc)])
  @@index([sellerOrgId, status])
  @@map("market_orders")
}

model MarketReview {
  id          String   @id @default(uuid(7)) @db.Uuid
  orderId     String   @unique @map("order_id") @db.Uuid
  sellerOrgId String   @map("seller_org_id") @db.Uuid
  buyerOrgId  String   @map("buyer_org_id") @db.Uuid
  rating      Int
  comment     String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([sellerOrgId])
  @@map("market_reviews")
}

// ---------------------------------------------------------------- Tahap 4: Keuangan
// Biaya pakan dan kesehatan TIDAK diinput ulang di sini: dihitung otomatis dari feed_records dan health_records.

enum FinanceKind {
  INCOME
  EXPENSE
}

enum InvoiceStatus {
  OPEN
  PAID
  VOID
}

model FinanceEntry {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  kind           FinanceKind
  category       String
  amount         Decimal     @db.Decimal(16, 2)
  occurredOn     DateTime    @map("occurred_on") @db.Date
  batchId        String?     @map("batch_id") @db.Uuid
  invoiceId      String?     @map("invoice_id") @db.Uuid
  description    String?
  recordedBy     String      @map("recorded_by") @db.Uuid
  clientId       String?     @map("client_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  voidedAt       DateTime?   @map("voided_at") @db.Timestamptz(6)
  voidedBy       String?     @map("voided_by") @db.Uuid
  voidReason     String?     @map("void_reason")

  @@unique([organizationId, clientId])
  @@index([organizationId, occurredOn(sort: Desc)])
  @@index([organizationId, batchId])
  @@map("finance_entries")
}

model Budget {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  month          String
  category       String
  amount         Decimal  @db.Decimal(16, 2)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, month, category])
  @@map("budgets")
}

model Invoice {
  id              String        @id @default(uuid(7)) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  number          String
  customerName    String        @map("customer_name")
  customerContact String?       @map("customer_contact")
  batchId         String?       @map("batch_id") @db.Uuid
  issueOn         DateTime      @map("issue_on") @db.Date
  dueOn           DateTime      @map("due_on") @db.Date
  description     String?
  amount          Decimal       @db.Decimal(16, 2)
  status          InvoiceStatus @default(OPEN)
  paidOn          DateTime?     @map("paid_on") @db.Date
  createdBy       String        @map("created_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([organizationId, number])
  @@index([organizationId, status, dueOn])
  @@map("invoices")
}

// ---------------------------------------------------------------- Tahap 5: Smart Ternak IoT
// Perangkat (ESP32, gateway, Node-RED) mengirim data lewat HTTP memakai token perangkat. Token disimpan sebagai hash.

enum DeviceStatus {
  ACTIVE
  DISABLED
}

enum AlertOp {
  GT
  LT
}

enum CommandStatus {
  PENDING
  SENT
  ACKED
}

model Device {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  farmId         String       @map("farm_id") @db.Uuid
  name           String
  locationName   String?      @map("location_name")
  status         DeviceStatus @default(ACTIVE)
  tokenHash      String       @unique @map("token_hash")
  tokenPrefix    String       @map("token_prefix")
  lastSeenAt     DateTime?    @map("last_seen_at") @db.Timestamptz(6)
  createdBy      String       @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([organizationId, id])
  @@index([organizationId, farmId])
  @@map("devices")
}

model SensorReading {
  id             BigInt   @id @default(autoincrement())
  organizationId String   @map("organization_id") @db.Uuid
  deviceId       String   @map("device_id") @db.Uuid
  metric         String
  value          Float
  recordedAt     DateTime @map("recorded_at") @db.Timestamptz(6)
  receivedAt     DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@index([deviceId, metric, recordedAt(sort: Desc)])
  @@index([organizationId, recordedAt(sort: Desc)])
  @@map("sensor_readings")
}

model AlertRule {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  deviceId       String   @map("device_id") @db.Uuid
  name           String
  metric         String
  op             AlertOp
  threshold      Float
  enabled        Boolean  @default(true)
  createdBy      String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organizationId, deviceId, metric])
  @@map("alert_rules")
}

model AlertEvent {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  ruleId         String    @map("rule_id") @db.Uuid
  deviceId       String    @map("device_id") @db.Uuid
  ruleName       String    @map("rule_name")
  metric         String
  op             AlertOp
  threshold      Float
  value          Float
  triggeredAt    DateTime  @default(now()) @map("triggered_at") @db.Timestamptz(6)
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(6)

  @@index([organizationId, triggeredAt(sort: Desc)])
  @@index([ruleId, resolvedAt])
  @@map("alert_events")
}

/// Antrean perintah ke perangkat (mis. nyalakan pakan/minum otomatis, kipas). Perangkat mengambil lewat polling.
model DeviceCommand {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  deviceId       String        @map("device_id") @db.Uuid
  command        String
  payload        Json?
  status         CommandStatus @default(PENDING)
  result         String?
  createdBy      String        @map("created_by") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt         DateTime?     @map("sent_at") @db.Timestamptz(6)
  ackedAt        DateTime?     @map("acked_at") @db.Timestamptz(6)

  @@index([deviceId, status])
  @@map("device_commands")
}

// Harga pasar yang dicatat organisasi sendiri (hasil survei pasar, pengepul, atau tawaran pembeli).
model MarketPrice {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  commodity      String
  unit           String
  price          Decimal  @db.Decimal(16, 2)
  region         String?
  source         String?
  observedOn     DateTime @map("observed_on") @db.Date
  recordedBy     String   @map("recorded_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  voidedAt       DateTime? @map("voided_at") @db.Timestamptz(6)

  @@index([organizationId, commodity, observedOn(sort: Desc)])
  @@map("market_prices")
}

// Pengiriman pesanan pasar: satu pengiriman per pesanan, dengan riwayat pelacakan yang tidak bisa diubah.
model MarketShipment {
  id             String    @id @default(uuid(7)) @db.Uuid
  orderId        String    @unique @map("order_id") @db.Uuid
  sellerOrgId    String    @map("seller_org_id") @db.Uuid
  buyerOrgId     String    @map("buyer_org_id") @db.Uuid
  method         String
  courier        String?
  trackingNumber String?   @map("tracking_number")
  fee            Decimal   @default(0) @db.Decimal(14, 2)
  etaOn          DateTime? @map("eta_on") @db.Date
  note           String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([sellerOrgId])
  @@index([buyerOrgId])
  @@map("market_shipments")
}

model MarketShipmentEvent {
  id          String   @id @default(uuid(7)) @db.Uuid
  shipmentId  String   @map("shipment_id") @db.Uuid
  sellerOrgId String   @map("seller_org_id") @db.Uuid
  buyerOrgId  String   @map("buyer_org_id") @db.Uuid
  status      String
  location    String?
  note        String?
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([shipmentId, createdAt])
  @@map("market_shipment_events")
}

// Pembayaran pesanan pasar (rekening bersama, mode manual): tidak ada pihak ketiga yang menahan dana.
// Status: AWAITING -> PROOF_SUBMITTED -> HELD -> RELEASED, atau DISPUTED -> REFUNDED.
model MarketPayment {
  id            String    @id @default(uuid(7)) @db.Uuid
  orderId       String    @unique @map("order_id") @db.Uuid
  buyerOrgId    String    @map("buyer_org_id") @db.Uuid
  sellerOrgId   String    @map("seller_org_id") @db.Uuid
  amount        Decimal   @db.Decimal(16, 2)
  method        String
  reference     String?
  status        String    @default("AWAITING")
  disputeReason String?   @map("dispute_reason")
  submittedAt   DateTime? @map("submitted_at") @db.Timestamptz(6)
  heldAt        DateTime? @map("held_at") @db.Timestamptz(6)
  releasedAt    DateTime? @map("released_at") @db.Timestamptz(6)
  refundedAt    DateTime? @map("refunded_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([buyerOrgId])
  @@index([sellerOrgId, status])
  @@map("market_payments")
}

// ---------------------------------------------------------------- Konsultasi dokter hewan
// Profil dokter hewan bersifat publik (dibaca semua organisasi). Nomor izin diisi sendiri dan BELUM diverifikasi platform.
model VetProfile {
  orgId       String   @id @map("org_id") @db.Uuid
  displayName String   @map("display_name")
  city        String
  specialty   String
  licenseNo   String?  @map("license_no")
  about       String?
  accepting   Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("vet_profiles")
}

model VetConsultation {
  id          String   @id @default(uuid(7)) @db.Uuid
  farmOrgId   String   @map("farm_org_id") @db.Uuid
  vetOrgId    String   @map("vet_org_id") @db.Uuid
  farmName    String   @map("farm_name")
  subject     String
  species     String
  symptoms    String
  status      String   @default("OPEN")
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([farmOrgId, updatedAt(sort: Desc)])
  @@index([vetOrgId, status])
  @@map("vet_consultations")
}

model VetMessage {
  id             String   @id @default(uuid(7)) @db.Uuid
  consultationId String   @map("consultation_id") @db.Uuid
  farmOrgId      String   @map("farm_org_id") @db.Uuid
  vetOrgId       String   @map("vet_org_id") @db.Uuid
  authorOrgId    String   @map("author_org_id") @db.Uuid
  authorUserId   String   @map("author_user_id") @db.Uuid
  body           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([consultationId, createdAt])
  @@map("vet_messages")
}

// ---------------------------------------------------------------- Langganan dan penagihan
// Tagihan paket Nusa Ternak untuk organisasi. Pelunasan dikonfirmasi operator (transfer manual), lalu paket aktif.
model SubscriptionInvoice {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  number         String
  plan           Plan
  months         Int
  amount         Decimal   @db.Decimal(16, 2)
  status         String    @default("PENDING")
  dueOn          DateTime  @map("due_on") @db.Date
  paidAt         DateTime? @map("paid_at") @db.Timestamptz(6)
  createdBy      String    @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([organizationId, number])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("subscription_invoices")
}

// ---------------------------------------------------------------- API terbuka dan webhook
model ApiKey {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  keyPrefix      String    @map("key_prefix")
  keyHash        String    @unique @map("key_hash")
  createdBy      String    @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt     DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)

  @@index([organizationId])
  @@map("api_keys")
}

model WebhookEndpoint {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  url            String
  secret         String
  events         String[]
  active         Boolean   @default(true)
  createdBy      String    @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  endpointId     String    @map("endpoint_id") @db.Uuid
  event          String
  payload        Json
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  responseStatus Int?      @map("response_status")
  lastError      String?   @map("last_error")
  nextAttemptAt  DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}

// ---------------------------------------------------------------- Pembiayaan dan mitra
// Mitra (bank, koperasi, fintech, offtaker) dikelola operator platform. Platform hanya menghubungkan; keputusan ada di mitra.
model FinancingPartner {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String
  kind        String
  description String
  minAmount   Decimal? @map("min_amount") @db.Decimal(16, 2)
  maxAmount   Decimal? @map("max_amount") @db.Decimal(16, 2)
  rateInfo    String?  @map("rate_info")
  contactUrl  String?  @map("contact_url")
  contactPhone String? @map("contact_phone")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("financing_partners")
}

model FinancingApplication {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  partnerId      String    @map("partner_id") @db.Uuid
  amount         Decimal   @db.Decimal(16, 2)
  tenorMonths    Int       @map("tenor_months")
  purpose        String
  note           String?
  snapshot       Json
  status         String    @default("SUBMITTED")
  partnerNote    String?   @map("partner_note")
  createdBy      String    @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("financing_applications")
}

// Foto kamera kandang yang dikirim perangkat lewat HTTP (ESP32-CAM, Node-RED). Disimpan terbatas (lihat server/snapshots.ts).
model CameraSnapshot {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  deviceId       String   @map("device_id") @db.Uuid
  contentType    String   @map("content_type")
  sizeBytes      Int      @map("size_bytes")
  data           Bytes
  capturedAt     DateTime @default(now()) @map("captured_at") @db.Timestamptz(6)

  @@index([deviceId, capturedAt(sort: Desc)])
  @@index([organizationId, capturedAt(sort: Desc)])
  @@map("camera_snapshots")
}
