{
  "name": "smart-livestock",
  "private": true,
  "version": "0.1.0",
  "description": "Smart Livestock Ecosystem - monorepo (web, database, permissions, validation)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @sl/web dev",
    "build": "pnpm --filter @sl/web build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @sl/database generate",
    "db:push": "pnpm --filter @sl/database push",
    "db:migrate": "pnpm --filter @sl/database migrate",
    "db:rls": "pnpm --filter @sl/database rls",
    "db:seed": "pnpm --filter @sl/database seed",
    "db:setup": "pnpm db:generate && pnpm db:push && pnpm db:rls && pnpm db:seed"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
