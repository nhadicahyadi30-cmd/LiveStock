# Salin menjadi .env (root) dan .env.local (apps/web) sesuai kebutuhan.
# Aplikasi memakai role app_user (tanpa BYPASSRLS). Migrasi memakai role migrator.

DATABASE_URL="postgresql://app_user:app_user_dev@localhost:5432/smart_livestock"
MIGRATION_DATABASE_URL="postgresql://migrator:migrator_dev@localhost:5432/smart_livestock"

# Hanya untuk pengembangan lokal: mengaktifkan penyedia sesi palsu (x-dev-user-id).
# Wajib dikosongkan atau dihapus di staging dan production.
ENABLE_DEV_SESSION="true"

# Rahasia penandatangan cookie sesi (minimal 32 karakter). Buat dengan: openssl rand -base64 48
SESSION_SECRET="ganti-dengan-rahasia-acak-minimal-32-karakter"

# Langganan: teks cara bayar yang tampil di halaman Langganan (rekening, QRIS, dsb.).
BILLING_PAYMENT_INFO="Transfer ke rekening pengelola, lalu kirim bukti ke WhatsApp pengelola."
# Token operator untuk mengonfirmasi pembayaran (POST /api/operator/billing/confirm). Minimal 24 karakter; kosong = endpoint mati.
BILLING_OPERATOR_TOKEN=""

# Izinkan webhook ke alamat lokal/http (Node-RED lokal). JANGAN aktif di production.
ALLOW_PRIVATE_WEBHOOKS="false"
